{
  "name": "@remy-ai/webmcp",
  "version": "0.1.0-alpha.1",
  "description": "Expose Remy actions through the browser WebMCP API.",
  "keywords": [
    "webmcp",
    "ai",
    "agents",
    "browser",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external @remy-ai/core",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@remy-ai/core": "0.1.0-alpha.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MustafaK99/Remy.git",
    "directory": "packages/webmcp"
  },
  "bugs": {
    "url": "https://github.com/MustafaK99/Remy/issues"
  },
  "homepage": "https://github.com/MustafaK99/Remy#readme",
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
